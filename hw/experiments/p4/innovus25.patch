-rc=${PIPESTATUS[0]}
-[ "$rc" -eq 0 ] || die "innovus 退出码 $rc（见 $PNR_OUT/pnr.log）"
+timeout 14400 innovus -no_gui -legacy_ui -batch -files flow/pnr/pnr.tcl > "$PNR_OUT/pnr.log" 2>&1 9>&- &
+launcher=$!
+(
+  low=0
+  while kill -0 "$launcher" 2>/dev/null; do
+    if awk '/MemAvailable/ {available=$2} /SwapFree/ {swap=$2}
+            END {exit !(available < 400000 && swap < 400000)}' /proc/meminfo; then
+      low=$((low + 1))
+    else
+      low=0
+    fi
+    if [ "$low" -ge 3 ]; then
+      echo "[pnr] WSL memory exhausted; stopping only this Innovus run" >&2
+      kill -TERM "$launcher" 2>/dev/null || :
+      break
+    fi
+    sleep 5
+  done
+) 9>&- &
+watchdog=$!
+wait "$launcher"
+rc=$?
+kill "$watchdog" 2>/dev/null || :
+if [ "$rc" -ne 0 ]; then
+    tail -30 "$PNR_OUT/pnr.log" >&2
+    die "innovus 退出码 $rc（见 $PNR_OUT/pnr.log）"
+fi
 grep -q "\[pnr\] ========== DONE ==========" "$PNR_OUT/pnr.log" \
     || die "流程没跑到 DONE（见 $PNR_OUT/pnr.log 末尾）"


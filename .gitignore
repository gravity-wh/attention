# =====================================================================
#  数字集成电路设计 · 课程项目 .gitignore
#  原则：源码 / 脚本 / 向量 / 提取后的指标 进库；
#        一切「跑一次就生成」的东西不进库。
# =====================================================================

# ---- 仿真产物 ----
*.vcd
*.fsdb
*.fst
*.shm
*.vpd
*.wlf
*.sdf
*.saif
simv
simv.daidir/
csrc/
obj_dir/
xsim.dir/
xcelium.d/
INCA_libs/
work/
*.log
*.jou
*.str
transcript
wave*.do

# ---- 综合 / 后端产物 ----
*.ddc
*.db
*.sdb
*.svf
*.mapped.v
*.mapped.sdc
*.spef
*.def
*.gds
*.oas
*.ndm
*.enc.dat
alib-*/
fascia/
*.pwr
*.fsdb.gz

# ---- 运行目录（每次跑都新建，只留占位）----
hw/runs/**
!hw/runs/.gitkeep

# ---- 覆盖率数据库与报告（urg 生成，可随时重算）----
*.vdb/
simv.vdb/
urgReport/
hw/**/urgReport/

# ---- 完整向量集：616 个任务约 9.8 MB，按需生成 ----
# 只提交 smoke 集（每类 2 个任务），保证别人不经模型也能快速复跑；
# seed 已进库，full 集永远可由 `make vec MODE=full` 逐位重算出来。
hw/tb/vectors/*_full/

# ---- 交付导出物（报告 pdf / pptx / 打包 zip）----
deliverables/**
!deliverables/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---- 模型层编译产物（make 一次就生成）----
#  Windows 产物带 .exe，Linux 产物不带；两边都要忽略，否则在 NAS 上
#  git status 会把四个可执行文件报成未跟踪，掩盖真正的改动。
*.exe
hw/model/attn_baseline
hw/model/attn_selftest
hw/model/attn_dumpvec
hw/model/sweep

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# ---- 大文件红线：单文件 > 20MB 一律不进库（用 Git LFS 或外链）----

# ---- Agent 内部状态（不是项目内容）----
.workbuddy/
